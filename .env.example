# ==========================================
# A Little Place for Us ♡ - Environment Configuration
# ==========================================

# Next.js App URL (used for auth redirects & invitations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Supabase Server-only Secret Key (NEVER expose to client!)
# Optional: Only needed for administrative scripts/triggers if required
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share

# Administrator emails permitted to approve access or generate invitations
ADMIN_EMAILS=user1@example.com,user2@example.com
